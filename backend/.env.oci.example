# Copiar a .env.oci.local en backend y completar los valores en un editor local.
# Para la comparación inicial, usar el propietario de la restauración.
# Para operación, usar los dos usuarios con permisos limitados.
OLTP_PG_HOST=127.0.0.1
OLTP_PG_PORT=5433
OLTP_PG_DATABASE=mmet_bi_oltp
OLTP_PG_USER=mmet_oltp_runtime
OLTP_PG_PASSWORD=
OLTP_PG_SSL=true
OLTP_PG_SSL_MODE=verify-full
OLTP_PG_CA_FILE=
OLTP_PG_SERVERNAME=

DM_PG_HOST=127.0.0.1
DM_PG_PORT=5433
DM_PG_DATABASE=mmet_bi_dm
DM_PG_USER=mmet_dm_runtime
DM_PG_PASSWORD=
DM_PG_SSL=true
DM_PG_SSL_MODE=verify-full
DM_PG_CA_FILE=
DM_PG_SERVERNAME=
