# =============================================================================
# MMET_BI Backend — Variables de entorno de ejemplo
# Copiar a `.env` y completar con credenciales locales (nunca subir `.env` a Git)
# =============================================================================

PORT=4000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# --- PostgreSQL 17: DOS bases independientes ---
OLTP_PG_HOST=127.0.0.1
OLTP_PG_PORT=5432
OLTP_PG_DATABASE=mmet_bi_oltp
OLTP_PG_USER=postgres
OLTP_PG_PASSWORD=CambiarClavePostgres
OLTP_PG_SSL=false

DM_PG_HOST=127.0.0.1
DM_PG_PORT=5432
DM_PG_DATABASE=mmet_bi_dm
DM_PG_USER=postgres
DM_PG_PASSWORD=CambiarClavePostgres
DM_PG_SSL=false
# OCI Bastion: host local, puerto del túnel, TLS y nombre del endpoint privado.
# DM_PG_CA_FILE=C:/ruta/certificado.pem
# DM_PG_SERVERNAME=endpoint.postgresql.region.oci.oraclecloud.com

# --- Autenticación inicial (ADMIN bootstrap) ---
BOOTSTRAP_ADMIN_USERNAME=admin-local
BOOTSTRAP_ADMIN_PASSWORD=CambiarPorClaveDeAlMenos14Caracteres!

# --- IA Generativa (RQ-BI-15) — Cliente compatible con OpenAI API ---
# Por defecto configurado para Alibaba Cloud Model Studio (DashScope / Qwen).
# Puede cambiarse por cualquier endpoint OpenAI-compatible (OpenAI, Gemini OpenAI compat, etc.).
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
AI_TIMEOUT_MS=20000
