# =============================================================================
# MMET_BI Backend — Variables de entorno de ejemplo
# Copiar a `.env` y completar con credenciales locales (nunca subir `.env` a Git)
# =============================================================================

PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Microsoft SQL Server (MMET_BI_OLTP + esquema dm) ---
# Modo de autenticación: "windows" (local Windows Auth) o "sql" (SQL Auth / Docker / nube)
DB_AUTH_MODE=windows
DB_SERVER=localhost
DB_DATABASE=MMET_BI_OLTP
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Solo requeridos cuando DB_AUTH_MODE=sql
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=CambiarPorPasswordSeguro123!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# --- Autenticación inicial (ADMIN bootstrap) ---
BOOTSTRAP_ADMIN_USERNAME=admin-local
BOOTSTRAP_ADMIN_PASSWORD=CambiarPorClaveDeAlMenos14Caracteres!

# --- IA Generativa (RQ-BI-15) — Cliente compatible con OpenAI API ---
# Por defecto configurado para Alibaba Cloud Model Studio (DashScope / Qwen).
# Puede cambiarse por cualquier endpoint OpenAI-compatible (OpenAI, Gemini OpenAI compat, etc.).
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
AI_TIMEOUT_MS=20000
